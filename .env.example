APP_NAME=AutoHR-Backend
APP_VERSION=1.0.0
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Local PostgreSQL Configuration (Office PC)
DATABASE_URL=postgresql+psycopg2://autohr_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/autohr

# Local Security & Authentication
AUTH_TOKEN=kone_autohr_secure_token_change_in_production
KEY_PROVIDER=windows_dpapi
STORAGE_PROVIDER=local

# Local File Storage Paths
AUTOHR_STORAGE_PATH=storage
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=52428800

# Network & CORS (include office LAN IP if accessing from other PCs, e.g. http://192.168.1.100:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Audio Devices (Office Host virtual audio cable & monitor)
AUDIO_OUTPUT_DEVICE=CABLE Input
AUDIO_MONITOR_DEVICE=Realtek Speakers
ENABLE_LOCAL_MONITOR=false

# Browser Automation (Office Host only)
EDGE_CHANNEL=msedge

# External Cloud Services (Sarvam TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_PROJECT_ID=

# External Cloud Services (LLM)
LLM_PROVIDER=openai
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Microsoft Integration (Office Host Teams/Edge)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/microsoft/callback
MICROSOFT_ACCESS_TOKEN=

LOG_LEVEL=INFO
LOG_FORMAT=text
